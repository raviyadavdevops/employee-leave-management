            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{elmManagerId}}\",\n  \"first_name\": \"Demo\",\n  \"last_name\": \"Manager\",\n  \"email\": \"{{elmManagerEmail}}\",\n  \"department\": \"Engineering\",\n  \"manager_id\": null,\n  \"hire_date\": \"2025-01-01\"\n}"
            },
            "url": "{{elmApiBaseUrl}}/api/v1/employees/"
          }
        },
        {
          "name": "Create Employee Profile",
          "request": {
