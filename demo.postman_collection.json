            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{elmEmployeeId}}\",\n  \"first_name\": \"Demo\",\n  \"last_name\": \"Employee\",\n  \"email\": \"{{elmEmployeeEmail}}\",\n  \"department\": \"Engineering\",\n  \"manager_id\": \"{{elmManagerId}}\",\n  \"hire_date\": \"2025-01-10\"\n}"
            },
            "url": "{{elmApiBaseUrl}}/api/v1/employees/"
          }
        },
        {
          "name": "Get My Employee Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{elmEmployeeToken}}" }],
            "url": "{{elmApiBaseUrl}}/api/v1/employees/me"
          }
